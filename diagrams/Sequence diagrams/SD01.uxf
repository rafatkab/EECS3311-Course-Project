<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>UMLSequenceAllInOne</id>
    <coordinates>
      <x>40</x>
      <y>40</y>
      <w>1800</w>
      <h>1700</h>
    </coordinates>
    <panel_attributes>title=UC01 / UC02 - Create Course and Upload Learning Materials
obj=Student~s
obj=Course Dashboard UI~ui
obj=CourseController~cc
obj=user:User~u
obj=course:Course~c
obj=material:LearningMaterial~m

s-&gt;&gt;&gt;ui : 1. select Create Course
ui.&gt;s : 2. display course form
s-&gt;&gt;&gt;ui : 3. submit course information
ui-&gt;&gt;&gt;cc : 4. createCourse(courseData); on=cc
combinedFragment=alt~createAlt s m; cc:[Missing / invalid fields]
cc.&gt;ui : 5a. validationError
ui.&gt;s : 6a. display error message
..=createAlt; cc:[Valid information]
cc-&gt;&gt;&gt;u : 5b. createCourse(); on=u
u-&gt;&gt;&gt;c : 6b. &lt;&lt;create&gt;&gt;; on=c
c.&gt;u : 7b. course created; off=c
u.&gt;cc : 8b. Course; off=u
cc.&gt;ui : 9b. Course
ui.&gt;s : 10b. display new course
--=createAlt; off=cc
tick=3
s:[UC02 - Upload Learning Material]
s-&gt;&gt;&gt;ui : 11. select Upload Learning Materials
ui.&gt;s : 12. display file selector
s-&gt;&gt;&gt;ui : 13. select file(s)
ui-&gt;&gt;&gt;cc : 14. uploadMaterial(course, file); on=cc
combinedFragment=alt~uploadAlt s m; cc:[Unsupported / oversized / corrupted file]
cc.&gt;ui : 15a. uploadError
ui.&gt;s : 16a. display upload error
..=uploadAlt; cc:[Valid file]
cc-&gt;&gt;&gt;c : 15b. addMaterial(); on=c
c-&gt;&gt;&gt;m : 16b. &lt;&lt;create&gt;&gt;; on=m
m.&gt;c : 17b. LearningMaterial; off=m
c.&gt;cc : 18b. material added; off=c
cc.&gt;ui : 19b. upload successful
ui.&gt;s : 20b. display material on course page
--=uploadAlt; off=cc</panel_attributes>
    <additional_attributes />
  </element>
